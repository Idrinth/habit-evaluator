<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="habit-evaluator.db" />
        <include domain="sharedpref" path="habit_evaluator_settings.xml" />
        <exclude domain="database" path="habit-evaluator.db-journal" />
        <exclude domain="database" path="habit-evaluator.db-wal" />
        <exclude domain="database" path="habit-evaluator.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="habit-evaluator.db" />
        <include domain="sharedpref" path="habit_evaluator_settings.xml" />
        <include domain="file" path="backups/" />
        <exclude domain="database" path="habit-evaluator.db-journal" />
        <exclude domain="database" path="habit-evaluator.db-wal" />
        <exclude domain="database" path="habit-evaluator.db-shm" />
    </device-transfer>
</data-extraction-rules>
