<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <ImageButton
        android:id="@+id/expandCollapseButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_expand_more"
        android:contentDescription="@string/expand_emotion_entries"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:rotation="-90" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/emotionPairText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/currentStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/addEmotionEntryButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/add_emotion_entry"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />

    <ImageButton
        android:id="@+id/deleteEmotionPairButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="@string/delete_emotion_pair"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />
</LinearLayout>
