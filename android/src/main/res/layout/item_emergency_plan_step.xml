<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stepNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/moveUpButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@android:drawable/arrow_up_float"
                android:contentDescription="@string/emergency_plan_move_up"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/moveDownButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@android:drawable/arrow_down_float"
                android:contentDescription="@string/emergency_plan_move_down"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/editStepButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="@string/emergency_plan_edit_step"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/deleteStepButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="@string/emergency_plan_delete_step"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside" />
        </LinearLayout>

        <TextView
            android:id="@+id/stepQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
