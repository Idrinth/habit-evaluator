<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recordEmotionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/record_emotion_entry"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emotionPairLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/negativeEndLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:gravity="start" />

            <TextView
                android:id="@+id/positiveEndLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:gravity="end" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/strengthSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="20"
            android:progress="10" />

        <TextView
            android:id="@+id/strengthValueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/emotion_notes_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:maxLength="500" />

        <Button
            android:id="@+id/recordEmotionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/record_emotion" />

    </LinearLayout>
</ScrollView>
